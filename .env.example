# Create .env from this file. Change the setup key (never commit .env).
APP_SETUP_KEY=CHANGE-THIS-TO-A-RANDOM-LONG-SECRET
HOST_PORT=8765
TZ=Asia/Shanghai
# Use 0 for local HTTP, 1 only behind working HTTPS.
COOKIE_SECURE=0
# Optional: if Docker Hub fails, use the AWS ECR Public official Python mirror:
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-alpine
# Optional: if Alpine apk mirror is slow in your area:
# ALPINE_MIRROR=mirrors.tuna.tsinghua.edu.cn
